:root { --bg: #000000; --card: #121212; --card-2: #1c1c1c; --line: rgba(255, 255, 255, 0.14); --txt: #ffffff; --muted: #a3a3a3; --accent: #0095f6; --green: #22c55e; --red: #ef4444; --gold: #f59e0b; --chat-font: 13px; --ig-ring: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); }

body[data-theme="ocean"] { --bg: #050d1a; --card: #0c192e; --card-2: #152642; --accent: #38bdf8; }

body[data-theme="emerald"] { --bg: #04120d; --card: #0a2018; --card-2: #123327; --accent: #10b981; }

body[data-theme="royal"] { --bg: #090514; --card: #140d2b; --card-2: #201542; --accent: #a855f7; }

body.privacy-blur .app-wrap { filter: blur(12px); transition: filter 0.2s; }

* { box-sizing: border-box; font-family: Tahoma, Arial, sans-serif; }

html, body { margin: 0px; padding: 0px; background: var(--bg); color: var(--txt); }

.app-wrap { width: 100%; max-width: 480px; margin: 0px auto; min-height: 100vh; background: var(--bg); border-left: 1px solid var(--line); border-right: 1px solid var(--line); padding-bottom: 86px; }

.top-bar { position: sticky; top: 0px; z-index: 30; background: rgba(0, 0, 0, 0.95); border-bottom: 1px solid var(--line); padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; gap: 6px; }

.top-brand { display: flex; align-items: center; gap: 9px; min-width: 0px; cursor: pointer; }

.brand-mark { width: 36px; height: 36px; border-radius: 11px; background: linear-gradient(135deg, var(--accent), #bc1888); display: grid; place-items: center; font-size: 19px; font-weight: bold; color: rgb(255, 255, 255); overflow: hidden; flex-shrink: 0; }

.brand-mark img { width: 100%; height: 100%; object-fit: cover; }

.top-title { font-size: 15px; font-weight: bold; }

.top-sub { font-size: 10.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 135px; }

.top-actions { display: flex; align-items: center; gap: 5px; }

.mini-pill { width: auto; padding: 6px 8px; border-radius: 999px; font-size: 10.5px; white-space: nowrap; }

.top-status { padding: 5px 8px; border-radius: 999px; font-size: 10.5px; font-weight: bold; cursor: pointer; white-space: nowrap; }

.top-status.locked { background: rgba(239, 68, 68, 0.18); color: rgb(252, 165, 165); border: 1px solid rgba(239, 68, 68, 0.4); }

.top-status.open { background: rgba(34, 197, 94, 0.18); color: rgb(134, 239, 172); border: 1px solid rgba(34, 197, 94, 0.4); }

.stories-row { display: flex; gap: 11px; padding: 10px 14px; overflow-x: auto; border-bottom: 1px solid var(--line); }

.story-btn { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 66px; cursor: pointer; }

.story-frame { width: 54px; height: 54px; border-radius: 50%; padding: 2px; background: var(--ig-ring); display: grid; place-items: center; }

.story-frame img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid var(--bg); background: var(--card-2); }

.story-label { font-size: 11px; font-weight: bold; max-width: 72px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.story-status-txt { font-size: 10px; color: var(--muted); max-width: 74px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.rooms-bar { display: flex; gap: 6px; padding: 8px 14px; overflow-x: auto; border-bottom: 1px solid var(--line); background: rgba(255, 255, 255, 0.02); }

.room-chip { width: auto; padding: 5px 10px; border-radius: 999px; font-size: 11px; background: var(--card-2); border: 1px solid var(--line); color: var(--muted); white-space: nowrap; }

.room-chip.active-room { background: var(--accent); border-color: var(--accent); color: rgb(255, 255, 255); }

.alert-bar { display: none; background: rgb(20, 83, 45); color: rgb(236, 253, 245); padding: 9px 14px; font-size: 12px; font-weight: bold; align-items: center; justify-content: space-between; gap: 8px; border-bottom: 1px solid var(--line); }

.alert-bar.show { display: flex; }

.page-view { display: none; padding: 13px; }

.page-view.active { display: block; }

.box-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 13px; margin-bottom: 12px; }

.box-title { font-size: 13.5px; font-weight: bold; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }

label { display: block; font-size: 11.5px; color: var(--muted); margin-bottom: 5px; }

input, select, textarea, button { width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--card-2); color: var(--txt); font-size: 13px; outline: none; }

button { cursor: pointer; font-weight: bold; }

.b-accent { background: var(--accent); border-color: var(--accent); color: rgb(255, 255, 255); }

.b-green { background: var(--green); border-color: var(--green); color: rgb(5, 32, 16); }

.b-red { background: rgba(239, 68, 68, 0.18); border-color: rgba(239, 68, 68, 0.45); color: rgb(252, 165, 165); }

.b-gold { background: rgba(245, 158, 11, 0.18); border-color: rgba(245, 158, 11, 0.45); color: rgb(253, 230, 138); }

.two-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }

.three-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }

.four-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }

