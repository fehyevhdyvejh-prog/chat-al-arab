.bubble a { color: rgb(253, 224, 71); text-decoration: underline; word-break: break-all; }

.bubble img { display: block; max-width: 100%; max-height: 190px; border-radius: 10px; margin-top: 6px; cursor: pointer; }

.bubble-enc { margin-top: 4px; font-size: 10px; opacity: 0.75; direction: ltr; text-align: left; overflow-x: auto; }

