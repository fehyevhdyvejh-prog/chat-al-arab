.nav-item { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 4px 2px; color: var(--muted); font-size: 17px; display: flex; flex-direction: column; align-items: center; gap: 2px; }

.nav-item span { font-size: 10px; }

