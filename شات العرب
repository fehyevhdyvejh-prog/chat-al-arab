.pub-card { background: linear-gradient(135deg, rgba(0, 149, 246, 0.14), rgba(188, 24, 136, 0.12)); border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 14px; padding: 12px; margin-bottom: 12px; }

.pub-grid { display: flex; flex-direction: column; gap: 8px; }

