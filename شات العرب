.reel-pill-btn.active-like { background: rgba(239, 68, 68, 0.22); border-color: rgba(239, 68, 68, 0.6); color: rgb(252, 165, 165); }

.reel-comments-box { margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--line); }

