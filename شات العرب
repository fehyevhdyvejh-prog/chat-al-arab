.reply-preview-bar { display: none; background: var(--card); border: 1px solid var(--accent); border-radius: 10px; padding: 6px 10px; margin-bottom: 6px; font-size: 11.5px; align-items: center; justify-content: space-between; gap: 8px; }

.reply-preview-bar.show { display: flex; }

.send-bar { display: flex; gap: 5px; align-items: center; }

