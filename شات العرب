.guide-step-box { background: var(--card-2); border-top-color: ; border-top-style: ; border-top-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-right: 3px solid var(--accent); border-radius: 10px; padding: 8px 10px; margin-bottom: 7px; font-size: 12px; line-height: 1.55; }

.saved-chip-btn.is-saved { background: rgba(245, 158, 11, 0.25); border-color: rgba(245, 158, 11, 0.7); color: rgb(253, 230, 138); }

.recovery-code-pill { direction: ltr; font-family: monospace; font-size: 13px; font-weight: bold; letter-spacing: 1.5px; background: rgba(16, 185, 129, 0.14); border: 1px dashed rgba(16, 185, 129, 0.6); color: rgb(110, 231, 183); padding: 8px 12px; border-radius: 10px; text-align: center; margin: 6px 0px; }

