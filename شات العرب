.ig-acc-name { font-size: 13px; font-weight: bold; }

.ig-acc-email { font-size: 10.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 175px; }

.ig-check { width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: rgb(255, 255, 255); font-size: 12px; display: grid; place-items: center; flex-shrink: 0; }

.post-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; margin-bottom: 12px; overflow: hidden; }

.post-top { padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }

.post-author { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: bold; }

.post-author img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }

.post-pic { width: 100%; max-height: 270px; object-fit: cover; display: block; cursor: pointer; }

.post-caption { padding: 10px 12px; font-size: var(--chat-font); line-height: 1.55; word-break: break-word; }

.post-caption a { color: var(--accent); text-decoration: underline; }

.pinned-banner { display: none; background: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.4); color: rgb(253, 230, 138); border-radius: 10px; padding: 7px 10px; font-size: 11.5px; margin-bottom: 8px; align-items: center; justify-content: space-between; gap: 8px; }

.pinned-banner.show { display: flex; }

.peer-row { display: flex; gap: 6px; align-items: flex-end; margin-bottom: 8px; }

.typing-bar { min-height: 19px; font-size: 11.5px; color: var(--green); padding: 0px 4px 5px; font-weight: bold; }

.msgs-box { height: 305px; overflow-y: auto; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 10px; margin-bottom: 8px; display: flex; flex-direction: column; gap: 8px; }

.bubble { max-width: 84%; padding: 8px 11px; border-radius: 15px; font-size: var(--chat-font); line-height: 1.5; word-break: break-word; }

.bubble.mine { align-self: flex-start; background: var(--accent); color: rgb(255, 255, 255); }

